{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.content.pageFolders": [
    {
      "title": "content",
      "path": "[[workspace]]/hugo/content"
    },
    {
      "title": "writings",
      "path": "[[workspace]]/hugo/content/writings"
    },
    {
      "title": "sidebar",
      "path": "[[workspace]]/hugo/content/sidebar"
    },
    {
      "title": "programming",
      "path": "[[workspace]]/hugo/content/programming"
    },
    {
      "title": "posts",
      "path": "[[workspace]]/hugo/content/posts"
    }
  ],
  "frontMatter.framework.startCommand": "hugo server -D -s hugo/ --poll 700ms"
}